{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KiYouJyo/UrbanPlanToolbox_Data/main/schemas/datapack-manifest.schema.json",
  "title": "UrbanPlanToolbox Data Pack Manifest",
  "type": "object",
  "required": ["formatVersion", "id", "version", "schemaVersion", "displayName", "minAppVersion", "dataPath", "publisher", "channel"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "displayName": {
      "type": "object",
      "required": ["zh-CN", "ja-JP", "en-US"],
      "properties": {
        "zh-CN": { "type": "string" },
        "ja-JP": { "type": "string" },
        "en-US": { "type": "string" }
      },
      "additionalProperties": false
    },
    "description": { "type": "object" },
    "minAppVersion": { "type": "string" },
    "dataPath": { "type": "string", "pattern": "^data/[^/]+\\.json$" },
    "schemaPath": { "type": "string" },
    "publisher": { "type": "string" },
    "channel": { "enum": ["stable", "preview"] }
  },
  "additionalProperties": false
}
