{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Concepts Data",
  "type": "object",
  "required": ["schemaVersion", "dataVersion", "lastReviewed", "labels", "sources", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d+$" },
    "lastReviewed": { "type": "string" },
    "labels": {
      "type": "object",
      "required": ["categories", "projectTypes", "tags"],
      "properties": {
        "categories": { "$ref": "#/$defs/localizedLabelCatalog" },
        "projectTypes": { "$ref": "#/$defs/localizedLabelCatalog" },
        "tags": { "$ref": "#/$defs/localizedLabelCatalog" }
      },
      "additionalProperties": false
    },
    "sources": { "type": "array" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stableId", "title", "category", "projectTypes", "tags", "definition", "caseNote", "sourceIds", "reviewStatus", "lastReviewed"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "stableId": { "type": "string", "pattern": "^concept-[a-z0-9-]+$" },
          "title": { "$ref": "#/$defs/localizedText" },
          "aliases": { "type": "array" },
          "category": { "type": "string" },
          "projectTypes": { "type": "array" },
          "tags": { "type": "array" },
          "definition": { "$ref": "#/$defs/localizedText" },
          "caseNote": { "$ref": "#/$defs/localizedText" },
          "sourceIds": { "type": "array", "minItems": 1 },
          "reviewStatus": { "enum": ["seed", "reviewed", "verified"] },
          "lastReviewed": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["zh-CN", "ja-JP", "en-US"],
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1 },
        "ja-JP": { "type": "string", "minLength": 1 },
        "en-US": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "localizedLabelCatalog": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/localizedText" }
    }
  },
  "additionalProperties": false
}
