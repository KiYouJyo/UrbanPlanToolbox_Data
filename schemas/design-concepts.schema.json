{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Concepts Data",
  "type": "object",
  "required": ["schemaVersion", "dataVersion", "lastReviewed", "sources", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "lastReviewed": { "type": "string" },
    "sources": { "type": "array" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stableId", "title", "category", "projectTypes", "tags", "definition", "caseNote", "sourceIds", "reviewStatus", "lastReviewed"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "stableId": { "type": "string", "pattern": "^concept-[a-z0-9-]+$" },
          "title": { "type": "object", "required": ["zh-CN", "ja-JP", "en-US"] },
          "aliases": { "type": "array" },
          "category": { "type": "string" },
          "projectTypes": { "type": "array" },
          "tags": { "type": "array" },
          "definition": { "type": "object", "required": ["zh-CN", "ja-JP", "en-US"] },
          "caseNote": { "type": "object", "required": ["zh-CN"] },
          "sourceIds": { "type": "array", "minItems": 1 },
          "reviewStatus": { "enum": ["seed", "reviewed", "verified"] },
          "lastReviewed": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
