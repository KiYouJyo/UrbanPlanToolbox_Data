{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planning Regulations Data",
  "type": "object",
  "required": ["schemaVersion", "dataVersion", "source", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "source": { "type": "object", "additionalProperties": true },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stableId", "region", "jurisdictionLevel", "topic", "documentLevel", "originalTitle", "chineseTitle", "scopeAndPurpose", "effectOrAdoption", "officialUrl", "verifiedDate"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "stableId": { "type": "string", "pattern": "^reg-\\d{4,}$" },
          "region": { "type": "string" },
          "jurisdictionLevel": { "type": "string" },
          "topic": { "type": "string" },
          "documentLevel": { "type": "string" },
          "originalTitle": { "type": "string" },
          "chineseTitle": { "type": "string" },
          "identifierOrYear": { "type": ["string", "null"] },
          "scopeAndPurpose": { "type": "string" },
          "effectOrAdoption": { "type": "string" },
          "officialUrl": { "type": "string" },
          "downloadUrl": { "type": ["string", "null"] },
          "downloadAndCopyrightNote": { "type": ["string", "null"] },
          "verifiedDate": { "type": "string" },
          "searchKeywords": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
